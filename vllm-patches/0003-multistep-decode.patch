+# Persistent pinned staging: under confidential computing every copy that touches a
+# freshly pinned host tensor pays a bounce-buffer setup toll (~ms), while copies from
+# a pinned buffer that already exists are cheap. VLLM_PINNED_STAGING=1 routes the
+# per-step host->device scalars/arrays through a small event-guarded ring of
+# persistent pinned buffers instead of x.pin_memory()/torch.tensor(pin_memory=True).
+_PINNED_STAGING = os.environ.get("VLLM_PINNED_STAGING", "0") == "1"
+
+# Under confidential computing a host->device copy blocks the CPU until every kernel queued
+# ahead of it on the same stream has finished, which serializes next-step input preparation
+# behind the current step. VLLM_CC_H2D_STREAM=1 issues staging copies on a dedicated stream
+# (which is idle, so the call returns immediately) and makes the compute stream wait on an
+# event before consuming. Only copies into per-slot / freshly allocated device buffers use
+# it; copies into persistent buffers that in-flight kernels may still read stay stream-ordered.
+_H2D_SIDE_STREAM = os.environ.get("VLLM_CC_H2D_STREAM", "0") == "1"
+_h2d_stream: torch.cuda.Stream | None = None
+
+
+def _side_stream() -> torch.cuda.Stream:
+    global _h2d_stream
+    if _h2d_stream is None:
+        _h2d_stream = torch.cuda.Stream()
+    return _h2d_stream
+
+
+# Persistent destination buffers (e.g. the CUDA-graph-captured query_start_loc) may still be
+# read by in-flight kernels, so they cannot be written from the side stream. Instead the host
+# data goes side-stream into a per-shape device ring slot, and a device-to-device copy on the
+# compute stream (stream-ordered, no host blocking) moves it into the persistent buffer.
+_dev_ring: dict[tuple, list[torch.Tensor]] = {}
+_dev_ring_next: dict[tuple, int] = {}
+_dev_ring_step: dict[tuple, list] = {}
+_DEV_RING_DEPTH = 8
+
+
+def persistent_h2d(dst: torch.Tensor, pinned_src: torch.Tensor) -> torch.Tensor:
+    key = (tuple(dst.shape), dst.dtype, dst.device.index)
+    slots = _dev_ring.setdefault(key, [])
+    if not slots:
+        slots.extend(torch.empty_like(dst) for _ in range(_DEV_RING_DEPTH))
+        _dev_ring_next[key] = 0
+        _dev_ring_step[key] = [None] * _DEV_RING_DEPTH
+    i = _dev_ring_next[key]; _dev_ring_next[key] = (i + 1) % _DEV_RING_DEPTH
+    slot = slots[i]
+    wait_step_consumed(_side_stream(), _dev_ring_step[key][i])
+    side_stream_copy(slot, pinned_src)          # host -> ring slot, side stream + event
+    _dev_ring_step[key][i] = current_step_id()
+    return dst.copy_(slot, non_blocking=True)   # ring slot -> persistent, compute stream (D2D)
+
+
+# Step bookkeeping for slot reuse when the CPU runs ahead of the GPU. Every staging slot
+# (pool slot or device ring slot) remembers the step in which it was last handed to
+# consumers; the step's end event is recorded on the compute stream by mark_step_end()
+# once all of that step's kernels are enqueued. Before a slot is rewritten on the side
+# stream, the side stream waits (on the GPU, no host block) for that step's end event.
+_step_id = [0]
+_step_end_events: dict[int, torch.cuda.Event] = {}
+
+
+def current_step_id() -> int:
+    return _step_id[0]
+
+
+def mark_step_end(stream: torch.cuda.Stream) -> None:
+    ev = torch.cuda.Event()
+    ev.record(stream)
+    sid = _step_id[0]
+    _step_end_events[sid] = ev
+    for old in [k for k in _step_end_events if k < sid - 16]:
+        del _step_end_events[old]
+    _step_id[0] = sid + 1
+
+
+def wait_step_consumed(stream: torch.cuda.Stream, sid: int | None) -> None:
+    """Make `stream` wait until the step that consumed a slot has fully executed."""
+    if sid is None:
+        return
+    ev = _step_end_events.get(sid)
+    if ev is not None:
+        stream.wait_event(ev)
+    elif sid >= _step_id[0]:
+        # The consuming step has not ended on the host yet (slot reused within a
+        # step or the pool is shallower than the in-flight depth): fall back to
+        # ordering behind everything currently on the compute stream.
+        stream.wait_stream(torch.cuda.current_stream())
+
+
+def side_stream_fresh(src: torch.Tensor, device: torch.device) -> torch.Tensor:
+    """Fresh device tensor = src (pinned host). Allocated on the side stream so the caching
+    allocator only reuses its block after the compute stream (recorded as a reader) is done
+    with it; allocating on the compute stream and writing from the side stream lets the
+    block be reused and rewritten while earlier compute-stream kernels still read it."""
+    main = torch.cuda.current_stream()
+    side = _side_stream()
+    with torch.cuda.stream(side):
+        out = torch.empty(src.shape, dtype=src.dtype, device=device)
+        out.copy_(src, non_blocking=True)
+        ev = torch.cuda.Event()
+        ev.record(side)
+    main.wait_event(ev)
+    out.record_stream(main)
+    return out
+
+
+def side_stream_copy(dst: torch.Tensor, src: torch.Tensor) -> torch.Tensor:
+    """dst.copy_(src) on the side stream; the caller's current stream waits for it."""
+    main = torch.cuda.current_stream()
+    side = _side_stream()
+    with torch.cuda.stream(side):
+        dst.copy_(src, non_blocking=True)
+        dst.record_stream(side)
+        ev = torch.cuda.Event()
+        ev.record(side)
+    main.wait_event(ev)
+    return dst
+
+
+class PinnedStagingRing:
+    """Ring of persistent pinned host buffers (one per dtype), grown on demand."""
+
+    def __init__(self, depth: int = 8, initial_numel: int = 1 << 16):
+        self.depth = depth
+        self.initial_numel = initial_numel
+        self._slots: dict[torch.dtype, list[tuple[torch.Tensor, torch.cuda.Event, bool]]] = {}
+        self._next: dict[torch.dtype, int] = {}
+
+    def stage(self, x: torch.Tensor) -> torch.Tensor:
+        """Copy CPU tensor `x` into a pinned slot; returns the pinned view (flat, same dtype)."""
+        dtype = x.dtype
+        slots = self._slots.setdefault(dtype, [])
+        if not slots:
+            for _ in range(self.depth):
+                slots.append((torch.empty(self.initial_numel, dtype=dtype, pin_memory=True), torch.cuda.Event(), False))
+            self._next[dtype] = 0
+        i = self._next[dtype]; self._next[dtype] = (i + 1) % self.depth
+        buf, ev, pending = slots[i]
+        if pending:
+            ev.synchronize()
+        n = x.numel()
+        if buf.numel() < n:
+            buf = torch.empty(max(n, 2 * buf.numel()), dtype=dtype, pin_memory=True)
+        view = buf[:n]
+        view.copy_(x.reshape(-1))
+        slots[i] = (buf, ev, True)
+        return view.view(x.shape), ev
+
+_staging_ring = PinnedStagingRing()
+
+
+def staged_h2d(x: torch.Tensor, out: torch.Tensor, side: bool = False) -> torch.Tensor:
+    """out.copy_(x) through the persistent pinned ring; records the slot's event."""
+    view, ev = _staging_ring.stage(x)
+    if side:
+        side_stream_copy(out, view)
+        ev.record(_side_stream())
+        return out
+    out.copy_(view, non_blocking=True)
+    ev.record()
+    return out
+
