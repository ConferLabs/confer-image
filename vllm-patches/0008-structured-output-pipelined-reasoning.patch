+    def truncate_at_marker(
+        self,
+        sampled_token_ids: torch.Tensor,
+        num_sampled: torch.Tensor,
+        num_rejected: torch.Tensor,
+        input_batch: InputBatch,
+        grammar_req_ids: list[str],
+        conditional_token_ids: list[int],
+    ) -> None:
+        """End each conditional request's window at its reasoning-end marker.
+
+        A window whose first input is the marker keeps exactly one token (the one
+        the initial mask constrained); a window that sampled the marker later keeps
+        the tokens up to and including it. Everything after is reported as rejected,
+        so the next window starts right after the marker or the constrained token.
+        """
+        num_reqs = input_batch.num_reqs
+        cond_np = np.full(num_reqs, -1, dtype=np.int32)
+        req_id_to_idx = {req_id: i for i, req_id in enumerate(input_batch.req_ids)}
+        for req_id, cond in zip(grammar_req_ids, conditional_token_ids):
+            if cond >= 0:
+                cond_np[req_id_to_idx[req_id]] = cond
+        with torch.cuda.stream(self.copy_stream):
+            cond_cpu = torch.tensor(
+                cond_np.tolist(), dtype=torch.int32, device="cpu", pin_memory=PIN_MEMORY
+            )
+            cond_reqs = self.cond_reqs[:num_reqs].copy_(cond_cpu, non_blocking=True)
+        current_stream = torch.cuda.current_stream()
+        current_stream.wait_stream(self.copy_stream)
+        _truncate_at_marker_kernel[(num_reqs,)](
+            sampled_token_ids,
+            sampled_token_ids.stride(0),
+            sampled_token_ids.shape[1],
+            num_sampled,
+            num_rejected,
+            input_batch.cu_num_logits,
+            input_batch.logits_indices,
+            input_batch.input_ids,
+            cond_reqs,
+            num_warps=1,
+        )
+        self.copy_stream.wait_stream(current_stream)
+
+
+def _expand_conditional(
+    req_ids: list[str],
+    grammar_req_ids: list[str],
+    conditional_token_ids: list[int],
+    cu_num_logits_np: np.ndarray,
+    num_draft_tokens_per_req: np.ndarray | None,
+    num_bonus_tokens: int,
+) -> np.ndarray:
+    """One conditional token id per mask row, in the mapping's order."""
+    values: list[int] = []
+    req_id_to_idx = {req_id: i for i, req_id in enumerate(req_ids)}
+    for grammar_req_id, cond in zip(grammar_req_ids, conditional_token_ids):
+        req_idx = req_id_to_idx[grammar_req_id]
+        if num_draft_tokens_per_req is None:
+            num_positions = int(
+                cu_num_logits_np[req_idx + 1] - cu_num_logits_np[req_idx]
+            )
+        else:
+            num_positions = int(num_draft_tokens_per_req[req_idx]) + num_bonus_tokens
+        values.extend([cond] * num_positions)
+    return np.asarray(values, dtype=np.int32)
+
+
+@triton.jit
+def _truncate_at_marker_kernel(
+    sampled_ptr,
+    sampled_stride,
+    max_sampled,
+    num_sampled_ptr,
+    num_rejected_ptr,
+    cu_num_logits_ptr,
+    logits_indices_ptr,
+    input_ids_ptr,
+    cond_ptr,
+):
+    req_idx = tl.program_id(0)
+    cond = tl.load(cond_ptr + req_idx)
+    if cond < 0:
+        return
+    start = tl.load(cu_num_logits_ptr + req_idx)
+    num_positions = tl.load(cu_num_logits_ptr + req_idx + 1) - start
+    marker_pos = -1
+    for k in range(num_positions):
+        token = tl.load(input_ids_ptr + tl.load(logits_indices_ptr + start + k))
+        marker_pos = tl.where((marker_pos < 0) & (token == cond), k, marker_pos)
+    if marker_pos < 0:
+        return
+    # Keep the tokens before the marker's position, or just the constrained token
+    # when the marker is the window's first input.
+    keep = tl.maximum(marker_pos, 1)
+    for k in range(keep, max_sampled):
+        tl.store(sampled_ptr + req_idx * sampled_stride + k, -1)
+    num_sampled = tl.load(num_sampled_ptr + req_idx)
+    new_num_sampled = tl.minimum(num_sampled, keep)
+    tl.store(num_sampled_ptr + req_idx, new_num_sampled)
+    tl.store(
+        num_rejected_ptr + req_idx,
+        tl.load(num_rejected_ptr + req_idx) + (num_sampled - new_num_sampled),
+    )
+
 
