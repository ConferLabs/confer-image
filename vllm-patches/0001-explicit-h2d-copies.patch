+# Zero-copy host buffers (UVA) let GPU kernels read pinned host memory in place.
+# Under NVIDIA confidential computing the GPU cannot access guest memory directly:
+# pinned allocations are serviced through encrypted UVM paging, so in-place reads
+# are neither cheap nor safe against the CPU rewriting a pool slot. With
+# VLLM_UVA_ZERO_COPY=0 every buffer is a device tensor filled by an explicit,
+# stream-ordered H2D copy, and pool slots are guarded by CUDA events.
+_ZERO_COPY = os.environ.get("VLLM_UVA_ZERO_COPY", "1") != "0"
 
+
+def uva_zero_copy_enabled() -> bool:
+    return _ZERO_COPY
+
